MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/eventstrand
JWT_SECRET=replace_with_64_char_random_string
GOOGLE_CLIENT_ID=60712789422-evmj4kjuc0joij1khsnpl2tamu4cv5kh.apps.googleusercontent.com
FRONTEND_URL=https://eventstrand.com
PORT=3000

# ── EMAIL (Resend) ─────────────────────────────────────────────
# Get an API key at https://resend.com/api-keys
# EMAIL_FROM must be a verified domain or use Resend's onboarding sender.
# If RESEND_API_KEY is unset, emails are logged to stdout (dev mode).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=EventStrand <noreply@eventstrand.com>
# ── OPS ────────────────────────────────────────────────────────
# Optional. Email address that receives "Database is DOWN" / "recovered"
# alerts (sent through Resend; needs RESEND_API_KEY). Unset = log only.
ALERT_EMAIL=you@example.com
# Optional. Days a user must wait between handle changes (first handle is
# always free). Default 30. 0 disables the cooldown.
HANDLE_COOLDOWN_DAYS=30

# ── PROFILE PHOTOS (Cloudflare R2) ─────────────────────────────
# All five are required for photo uploads; without them uploads return 503.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=eventstrand-images
# Public custom domain attached to the bucket, no trailing slash
R2_PUBLIC_URL=https://images.eventstrand.com
# Optional endpoint override (e.g. EU-jurisdiction bucket)
# R2_ENDPOINT=https://ACCOUNT_ID.eu.r2.cloudflarestorage.com
